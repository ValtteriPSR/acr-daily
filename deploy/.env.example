# Edit and save as deploy/.env. Do not commit the populated file!
# Dedicated subdomain: league.example.com (no https:// prefix)
CLUB_DOMAIN=league.example.com
# Optional PostgreSQL URL. Leave empty for persistent SQLite in deploy/data.
# To preserve the current club, reuse its Neon DATABASE_URL after stopping Render.
DATABASE_URL=''
ACR_MIN_LAUNCHER_VERSION=0.2.0
# Generate a lowercase private path, e.g. /panel- plus 32 random hex characters.
ADMIN_PANEL_PATH=/panel-replace-with-random-32-hex-characters
ACR_ADMIN_KEY=REPLACE_WITH_RANDOM_32_OR_MORE_CHARACTER_KEY
# Generate a random 32+ character hex secret; same value must reach proxy/app
ACR_GATEWAY_SECRET=REPLACE_WITH_RANDOM_SECRET_FROM_SECRETS_TOKEN_HEX_32
# Caddy bcrypt hash of a separate admin HTTP password. Use single quotes to keep $ characters literal.
ADMIN_PASSWORD_HASH='REPLACE_WITH_CADDY_BCRYPT_HASH'
# An installer built for CLUB_DOMAIN, not the old Render address.
ACR_LAUNCHER_DOWNLOAD_URL=https://github.com/YOUR_ACCOUNT/acr-daily/releases/tag/v0.2.2-custom-domain
